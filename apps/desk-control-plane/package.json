{
  "name": "@desk/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json --noEmit --pretty false && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "lint": "npm run typecheck && eslint src --max-warnings=0",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:visual": "node scripts/capture-visual-qa.mjs",
    "audit:command-center": "node scripts/audit-command-center-visual.mjs",
    "audit:live-trading": "node scripts/audit-live-trading-visual.mjs",
    "audit:performance": "node scripts/measure-bff-performance.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
