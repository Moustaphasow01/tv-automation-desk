{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "desk://contracts/live-focus-trade-card-v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["tradeCardId", "targetPositionId", "orderIntentId", "humanGateId", "instrument", "side", "operatorState", "theoreticalState", "priority", "allowedActions", "denialReasons", "source", "availability", "whyThisTrade"],
  "properties": {
    "tradeCardId": { "type": "string" },
    "targetPositionId": { "type": "string" },
    "orderIntentId": { "type": "string" },
    "humanGateId": { "type": "string" },
    "signalId": { "type": ["string", "null"] },
    "contextDecisionId": { "type": ["string", "null"] },
    "portfolioDecisionId": { "type": ["string", "null"] },
    "riskDecisionId": { "type": ["string", "null"] },
    "instrument": { "type": "string" },
    "side": { "type": "string" },
    "operatorState": { "type": "string" },
    "theoreticalState": { "type": "string" },
    "strategyProposedPlan": { "type": ["object", "null"] },
    "contextAdjustedPlan": { "type": ["object", "null"] },
    "riskAuthorizedPlan": { "type": ["object", "null"] },
    "authorizedQuantity": { "type": ["number", "null"] },
    "authorizedRisk": { "type": ["number", "null"] },
    "expectedR": { "type": ["number", "null"] },
    "priority": { "enum": ["ACTIONABLE", "ACTIVE", "PENDING", "TERMINAL"] },
    "allowedActions": { "type": "array", "items": { "type": "string" } },
    "denialReasons": { "type": "array", "items": { "type": "string" } },
    "realizedR": { "type": ["number", "null"] },
    "realizedPnL": { "type": ["number", "null"] },
    "source": { "const": "portfolio-order-intent" },
    "availability": { "const": "AVAILABLE" },
    "whyThisTrade": { "type": "object" }
  },
  "x-creation-invariant": "Created only when TargetPosition + OrderIntent + HumanGate canonical lineage all exist.",
  "x-separation-invariant": "Human CONFIRM, provider ACK, PARTIAL_FILL and FILL are distinct states."
}
