{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "desk://contracts/market-desk-brief-v1",
  "title": "MarketDeskBrief V1",
  "type": "object",
  "additionalProperties": true,
  "required": ["marketDeskBriefId", "marketContextSnapshotId", "schemaVersion", "universe", "createdAt", "validFrom", "validUntil", "sourceDataCutoff", "status", "headline", "operatorSummary", "whatDeskWants", "whatDeskAvoids", "sourceStates", "reasonCodes", "provenance"],
  "properties": {
    "marketDeskBriefId": { "type": "string", "minLength": 1 },
    "marketContextSnapshotId": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "market_desk_brief_v1" },
    "universe": { "const": "US_GRAINS_CBOT" },
    "createdAt": { "type": "string", "format": "date-time" },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "sourceDataCutoff": { "type": "string", "format": "date-time" },
    "status": { "enum": ["AVAILABLE", "STALE", "PARTIAL", "UNAVAILABLE", "INVALIDATED", "DISABLED_BY_POLICY"] },
    "headline": { "type": "string" },
    "operatorSummary": { "type": "string" },
    "marketInterpretation": { "type": ["string", "null"] },
    "deskIntent": { "type": ["string", "null"] },
    "whyNoTrade": { "type": ["string", "null"] },
    "whatDeskWants": { "type": "array", "items": { "type": "string" } },
    "whatDeskAvoids": { "type": "array", "items": { "type": "string" } },
    "opportunityZones": { "type": "array", "items": { "type": "object" } },
    "noTradeZones": { "type": "array", "items": { "type": "object" } },
    "invalidationConditions": { "type": "array", "items": { "type": "object" } },
    "currentCatalysts": { "type": "array", "items": { "type": "object" } },
    "nextExpectedEvents": { "type": "array", "items": { "type": "object" } },
    "instrumentViews": { "type": "array", "items": { "type": "object" } },
    "riskPosture": { "type": "object" },
    "sourceStates": { "type": "array", "items": { "type": "object" } },
    "reasonCodes": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "array", "items": { "type": "object" } },
    "workerId": { "type": ["string", "null"] },
    "taskId": { "type": ["string", "null"] },
    "modelPolicyVersion": { "type": ["string", "null"] },
    "promptVersion": { "type": ["string", "null"] },
    "supersedesBriefId": { "type": ["string", "null"] },
    "invalidationReason": { "type": ["string", "null"] }
  },
  "x-expiry": "A brief is projected STALE after validUntil and must never look current."
}
