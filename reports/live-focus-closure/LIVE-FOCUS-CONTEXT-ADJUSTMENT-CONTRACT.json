{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "desk://contracts/context-adjustment-proposal-v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["instrument", "side", "sourceDataCutoff", "reasonCodes", "evidenceRefs"],
  "properties": {
    "instrument": { "type": "string" },
    "side": { "enum": ["LONG", "SHORT"] },
    "sourceDataCutoff": { "type": "string", "format": "date-time" },
    "entry": { "type": "number" },
    "stop": { "type": "number" },
    "targets": { "type": "array", "items": { "type": "number" } },
    "quantity": { "type": "number", "minimum": 0 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "riskMultiplier": { "type": "number", "minimum": 0, "maximum": 1 },
    "reasonCodes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  },
  "x-validator-invariants": [
    "same instrument",
    "same side",
    "entry within Strategy envelope",
    "stop cannot increase risk",
    "targets cannot extend reward beyond Strategy",
    "quantity cannot increase",
    "confidence cannot increase",
    "risk multiplier cannot exceed 1",
    "no account or order-mode change",
    "no lookahead"
  ]
}
