    "test:telegram": "node --test mcp_gpt_desk/test/telegram_client.test.js mcp_gpt_desk/test/telegram_alert_service.test.js mcp_gpt_desk/test/telegram_delivery_runtime.test.js mcp_gpt_desk/test/telegram_trading_message.test.js mcp_gpt_desk/test/semi_manual_paper_readiness.test.js",
    "test:grains:data": "node --test mcp_gpt_desk/test/tradingview_webhook.test.js mcp_gpt_desk/test/postgres_data_health_active_scope.test.js mcp_gpt_desk/test/market_data_latency_audit.test.js scripts/stack/diagnose_tradingview_freshness.test.mjs",
    "test:grains:runtime": "node --test mcp_gpt_desk/test/us_grains_strategy_suite_once_runner.test.js mcp_gpt_desk/test/us_grains_live_signal_publisher.test.js mcp_gpt_desk/test/strategy_signal_bus_service.test.js",
    "test:grains:causal": "node --test mcp_gpt_desk/test/us_grains_causal_detection.test.js mcp_gpt_desk/test/us_grains_causal_invariants.test.js mcp_gpt_desk/test/grains_causal_detection_audit.test.js mcp_gpt_desk/test/grains_causal_context_prefilter.test.js mcp_gpt_desk/test/us_grains_theoretical_replay.test.js mcp_gpt_desk/test/us_grains_context_theoretical_replay.test.js mcp_gpt_desk/test/grains_calendar_coverage.test.js",
    "test:grains:calendar": "node --test mcp_gpt_desk/test/usda_grains_calendar_collector.test.js mcp_gpt_desk/test/grains_calendar_coverage.test.js mcp_gpt_desk/test/grains_calendar_evidence.test.js mcp_gpt_desk/test/grains_calendar_import.test.js mcp_gpt_desk/test/grains_calendar_import_cli.test.js mcp_gpt_desk/test/grains_calendar_detection.test.js mcp_gpt_desk/test/grains_calendar_instrument_scope.test.js",
    "test:grains:calendar-artifact": "node --test mcp_gpt_desk/test/grains_calendar_replay_artifact.test.js",
    "grains:import-calendar-evidence": "node mcp_gpt_desk/scripts/import_grains_calendar_evidence.mjs",
    "grains:collect-usda-calendar": "node mcp_gpt_desk/scripts/collect_usda_grains_calendar.mjs",
    "grains:refresh-usda-calendar": "node mcp_gpt_desk/scripts/refresh_usda_grains_calendar.mjs",
    "grains:correct-theoretical-outcomes": "node mcp_gpt_desk/scripts/correct_theoretical_trade_outcomes.mjs",
    "grains:qualify-historical-intents": "node mcp_gpt_desk/scripts/qualify_historical_grains_intents.mjs",
    "test:grains:calendar-refresh": "node --test mcp_gpt_desk/test/grains_calendar_freshness.test.js mcp_gpt_desk/test/grains_calendar_refresh.test.js mcp_gpt_desk/test/grains_calendar_file_archive.test.js mcp_gpt_desk/test/grains_calendar_refresh_source.test.js mcp_gpt_desk/test/grains_calendar_refresh_lease.test.js",
    "audit:grains:causal": "node mcp_gpt_desk/scripts/audit_grains_causal_detection.mjs",
    "grains:replay-context-theoretical": "node mcp_gpt_desk/scripts/replay_us_grains_context_theoretical.mjs",
    "grains:replay-canonical-postgres": "node mcp_gpt_desk/scripts/replay_us_grains_causal_postgres.mjs",
    "audit:grains:latency": "node mcp_gpt_desk/scripts/audit_market_data_latency.mjs",
