{
  "name": "tv-automation-desk-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
    "test:react": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism",
    "pretest:e2e": "VITE_DESK_API_KEY=e2e-operator-key vite build --mode development",
    "test:e2e": "playwright test",
    "test:stack": "bash scripts/stack/test_real_stack.sh",
    "test:grains:postgres": "node --input-type=module -e \"process.env.RUN_POSTGRES_TESTS='1'; await import('./mcp_gpt_desk/test/theoretical_execution_postgres.test.js');\"",
    "gate:demo-paper": "node scripts/stack/check_demo_paper_gate.mjs",
    "gate:vnext-operator": "node scripts/stack/check_vnext_operator_e2e.mjs",
    "gate:demo-paper-release": "node scripts/stack/check_demo_paper_release_gate.mjs",
    "doctor:demo-paper": "node scripts/stack/diagnose_demo_paper_readiness.mjs",
    "doctor:tradingview": "node scripts/stack/diagnose_tradingview_freshness.mjs",
    "doctor:ninja": "node scripts/stack/diagnose_ninjatrader_addon_readiness.mjs",
    "test:front": "npm run test:react && npm run test:e2e",
    "handoff:claude": "node scripts/handoff/build_claude_front_handoff.mjs",
    "handoff:front-freeze": "node scripts/front-handoff/generate_front_handoff.mjs",
    "probe:front-contract": "node scripts/front-handoff/probe_front_contract.mjs",
    "db:schema:apply": "python3 scripts/db/apply_postgres_schema.py",
    "guard:architecture": "node scripts/quality/check_architecture_boundaries.mjs",
    "guard:architecture:test": "node --test scripts/quality/check_architecture_boundaries.test.mjs",
    "guard:static-quality": "node scripts/quality/check_static_quality_guard.mjs",
    "guard:static-quality:test": "node --test scripts/quality/check_static_quality_guard.test.mjs",
    "guard:exceptions": "node scripts/quality/check_exception_register.mjs",
    "guard:exceptions:test": "node --test scripts/quality/check_exception_register.test.mjs",
    "guard:architecture-scorecard": "node scripts/quality/check_architecture_scorecard.mjs",
    "guard:architecture-scorecard:test": "node --test scripts/quality/check_architecture_scorecard.test.mjs",
    "guard:pr-governance": "node scripts/quality/check_pr_governance.mjs",
    "guard:pr-governance:test": "node --test scripts/quality/check_pr_governance.test.mjs",
    "guard:security-supply-chain": "node scripts/quality/check_security_supply_chain.mjs",
    "guard:security-supply-chain:test": "node --test scripts/quality/check_security_supply_chain.test.mjs",
    "guard:browser-secrets": "node scripts/quality/check_browser_secret_exposure.mjs",
    "guard:browser-secrets:test": "node --test scripts/quality/check_browser_secret_exposure.test.mjs",
    "guard:jira-backlog-sync": "node scripts/quality/check_jira_backlog_sync.mjs",
    "guard:sql-migrations": "node scripts/quality/check_sql_migrations.mjs",
    "guard:sql-migrations:test": "node --test scripts/quality/check_sql_migrations.test.mjs",
    "guard:problem-details": "node scripts/quality/check_problem_details.mjs",
    "guard:problem-details:test": "node --test scripts/quality/check_problem_details.test.mjs",
    "guard:runtime-safety": "node scripts/quality/check_runtime_safety.mjs",
    "guard:runtime-safety:test": "node --test scripts/quality/check_runtime_safety.test.mjs",
    "guard:mcp-slices": "node scripts/quality/check_mcp_tool_slices.mjs",
    "guard:mcp-slices:test": "node --test scripts/quality/check_mcp_tool_slices.test.mjs",
    "guard:jarvis-authority": "node scripts/quality/check_jarvis_authority.mjs",
    "guard:jarvis-authority:test": "node --test scripts/quality/check_jarvis_authority.test.mjs",
    "guard:prompt-registry": "node scripts/quality/check_prompt_registry.mjs",
    "guard:prompt-registry:test": "node --test scripts/quality/check_prompt_registry.test.mjs",
    "guard:front-architecture": "node scripts/quality/check_front_feature_architecture.mjs",
    "guard:front-architecture:test": "node --test scripts/quality/check_front_feature_architecture.test.mjs",
    "guard:api-compatibility": "node scripts/quality/check_api_compatibility.mjs",
    "guard:api-compatibility:test": "node --test scripts/quality/check_api_compatibility.test.mjs",
    "guard:front-vnext-legacy": "node scripts/quality/check_front_vnext_legacy_isolation.mjs",
    "guard:front-vnext-legacy:test": "node --test scripts/quality/check_front_vnext_legacy_isolation.test.mjs",
    "guard:front-vnext-data-mode": "node scripts/quality/check_front_vnext_runtime_data_mode.mjs",
    "guard:front-vnext-data-mode:test": "node --test scripts/quality/check_front_vnext_runtime_data_mode.test.mjs",
    "front-vnext:dev": "npm --prefix apps/desk-control-plane run dev",
    "front-vnext:build": "npm --prefix apps/desk-control-plane run build",
    "front-vnext:test": "npm --prefix apps/desk-control-plane run test",
    "front-vnext:e2e": "playwright test -c playwright.vnext.config.ts",
    "audit:front-a11y": "npm --prefix apps/desk-control-plane run audit:a11y",
    "audit:front-visual": "npm --prefix apps/desk-control-plane run audit:visual",
    "audit:front-performance": "npm --prefix apps/desk-control-plane run audit:performance",
    "audit:front-vocabulary": "npm --prefix apps/desk-control-plane run audit:vocabulary",
    "rules:uiux": "node docs/ui-ux/scripts/select-ui-ux-rules.mjs",
    "validate:uiux-rulebook": "python3 docs/ui-ux/scripts/validate-rulebook.py",
    "test:uiux-selector": "node docs/ui-ux/scripts/test-select-ui-ux-rules.mjs",
    "test:uiux-scanner": "node docs/ui-ux/scripts/test-ui-ux-audit.mjs",
    "test:uiux-rules": "npm run validate:uiux-rulebook && npm run test:uiux-selector && npm run test:uiux-scanner",
    "audit:uiux": "node docs/ui-ux/scripts/ui-ux-audit.mjs apps/desk-control-plane/src",
    "audit:uiux:report": "node docs/ui-ux/scripts/ui-ux-audit.mjs apps/desk-control-plane/src --json reports/ui-ux/front-v2-static-audit.json --no-fail",
    "guard:strategy-contracts": "node scripts/quality/check_strategy_contract_guard.mjs",
    "guard:windows-deployment": "node scripts/quality/check_windows_deployment_kit.mjs",
    "benchmark:local": "node scripts/quality/benchmark_local_readiness.mjs",
    "baseline:environment": "node scripts/quality/capture_environment_baseline.mjs",
    "baseline:environment:test": "node --test scripts/quality/capture_environment_baseline.test.mjs",
    "coverage:market-data": "npm --prefix mcp_gpt_desk run data:coverage -- --summary",
    "profile:market-data": "npm --prefix mcp_gpt_desk run data:capabilities -- --summary",
    "plan:market-storage": "npm --prefix mcp_gpt_desk run data:storage-plan -- --summary",
    "catalog:features": "npm --prefix mcp_gpt_desk run feature:catalog -- --summary",
    "certify:resilience": "node scripts/quality/certify_resilience.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.8.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
