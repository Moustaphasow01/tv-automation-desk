    "doctor:tradingview": "node scripts/stack/diagnose_tradingview_freshness.mjs",
    "doctor:ninja": "node scripts/stack/diagnose_ninjatrader_addon_readiness.mjs",
    "test:front": "npm run test:react && npm run test:e2e",
    "handoff:claude": "node scripts/handoff/build_claude_front_handoff.mjs",
