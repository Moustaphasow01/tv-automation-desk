    "baseline:environment:test": "node --test scripts/quality/capture_environment_baseline.test.mjs",
    "coverage:market-data": "npm --prefix mcp_gpt_desk run data:coverage -- --summary",
    "profile:market-data": "npm --prefix mcp_gpt_desk run data:capabilities -- --summary",
    "plan:market-storage": "npm --prefix mcp_gpt_desk run data:storage-plan -- --summary",
    "catalog:features": "npm --prefix mcp_gpt_desk run feature:catalog -- --summary",
    "certify:resilience": "node scripts/quality/certify_resilience.mjs"
