    "guard:strategy-contracts": "node scripts/quality/check_strategy_contract_guard.mjs",
    "guard:windows-deployment": "node scripts/quality/check_windows_deployment_kit.mjs",
    "benchmark:local": "node scripts/quality/benchmark_local_readiness.mjs",
