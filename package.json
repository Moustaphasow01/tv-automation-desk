{
  "name": "tv-automation-desk-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
    "test:react": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism",
    "pretest:e2e": "VITE_DESK_API_KEY=e2e-operator-key vite build --mode development",
    "test:e2e": "playwright test",
    "test:stack": "bash scripts/stack/test_real_stack.sh",
    "test:front": "npm run test:react && npm run test:e2e",
    "handoff:claude": "node scripts/handoff/build_claude_front_handoff.mjs",
    "db:schema:apply": "python3 scripts/db/apply_postgres_schema.py",
    "guard:strategy-contracts": "node scripts/quality/check_strategy_contract_guard.mjs",
    "guard:windows-deployment": "node scripts/quality/check_windows_deployment_kit.mjs",
    "benchmark:local": "node scripts/quality/benchmark_local_readiness.mjs",
    "certify:resilience": "node scripts/quality/certify_resilience.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.8.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
