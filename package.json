    "guard:jarvis-authority": "node scripts/quality/check_jarvis_authority.mjs",
    "guard:jarvis-authority:test": "node --test scripts/quality/check_jarvis_authority.test.mjs",
    "guard:prompt-registry": "node scripts/quality/check_prompt_registry.mjs",
    "guard:prompt-registry:test": "node --test scripts/quality/check_prompt_registry.test.mjs",
    "guard:front-architecture": "node scripts/quality/check_front_feature_architecture.mjs",
