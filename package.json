    "guard:runtime-safety": "node scripts/quality/check_runtime_safety.mjs",
    "guard:runtime-safety:test": "node --test scripts/quality/check_runtime_safety.test.mjs",
    "guard:mcp-slices": "node scripts/quality/check_mcp_tool_slices.mjs",
