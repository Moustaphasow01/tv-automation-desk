    "probe:front-contract": "node scripts/front-handoff/probe_front_contract.mjs",
    "db:schema:apply": "python3 scripts/db/apply_postgres_schema.py",
    "guard:architecture": "node scripts/quality/check_architecture_boundaries.mjs",
    "guard:architecture:test": "node --test scripts/quality/check_architecture_boundaries.test.mjs",
    "guard:static-quality": "node scripts/quality/check_static_quality_guard.mjs",
    "guard:static-quality:test": "node --test scripts/quality/check_static_quality_guard.test.mjs",
    "guard:exceptions": "node scripts/quality/check_exception_register.mjs",
    "guard:exceptions:test": "node --test scripts/quality/check_exception_register.test.mjs",
    "guard:architecture-scorecard": "node scripts/quality/check_architecture_scorecard.mjs",
    "guard:architecture-scorecard:test": "node --test scripts/quality/check_architecture_scorecard.test.mjs",
    "guard:pr-governance": "node scripts/quality/check_pr_governance.mjs",
    "guard:pr-governance:test": "node --test scripts/quality/check_pr_governance.test.mjs",
    "guard:security-supply-chain": "node scripts/quality/check_security_supply_chain.mjs",
