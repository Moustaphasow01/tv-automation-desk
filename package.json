    "front-vnext:build": "npm --prefix apps/desk-control-plane run build",
    "front-vnext:test": "npm --prefix apps/desk-control-plane run test",
    "front-vnext:e2e": "playwright test -c playwright.vnext.config.ts",
    "audit:front-a11y": "npm --prefix apps/desk-control-plane run audit:a11y",
    "audit:front-visual": "npm --prefix apps/desk-control-plane run audit:visual",
    "audit:front-performance": "npm --prefix apps/desk-control-plane run audit:performance",
    "audit:front-vocabulary": "npm --prefix apps/desk-control-plane run audit:vocabulary",
