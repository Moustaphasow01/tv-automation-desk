# Copiez ce fichier vers .env.preprod. Ce fichier ne contient aucun secret cloud.
POSTGRES_DB=desk
POSTGRES_USER=desk
POSTGRES_PASSWORD=desk_local_only
POSTGRES_PORT=5432
API_PORT=8787
FRONTEND_PORT=8080
DESK_MCP_API_KEY=local-preprod-key
DESK_OAUTH_ADMIN_PIN=12345678
DESK_OAUTH_TOKEN_SECRET=local-preprod-token-secret-change-me
DESK_OPERATOR_ADMIN_PIN=12345678
DESK_OPERATOR_SESSION_SECRET=local-operator-session-secret-change-me
TRADINGVIEW_WEBHOOK_SECRET=local-tradingview-secret
MARKET_FEED_ENVIRONMENT=preprod
DESK_NEWS_ENABLED=true
DESK_NEWS_GDELT_URL=https://api.gdeltproject.org/api/v2/doc/doc
