DESK_NEWS_MIN_REFRESH_MS=600000
DESK_NEWS_FAILURE_BACKOFF_MS=900000
DESK_NEWS_MAX_FAILURE_BACKOFF_MS=21600000
DESK_NEWS_TIMEOUT_MS=35000
DESK_NEWS_MAX_RECORDS=100
DESK_NEWS_RETENTION_DAYS=90
DESK_NINJA_ACCOUNT_SNAPSHOT_STALE_SECONDS=60
DESK_NINJA_ADDON_SHARED_SECRET=local-addon-hmac-secret-change-me-32chars
DESK_NINJA_STARTUP_CONTROL_HOST_ROOT=./.local/ninjatrader-control
DESK_NINJA_STARTUP_CONNECTION_NAME=Simulation
DESK_NINJA_STARTUP_CONNECTION_PROVIDER=NinjaTrader
DESK_TELEGRAM_ENABLED=false
DESK_TELEGRAM_COMMANDS_ENABLED=true
DESK_TELEGRAM_POLL_MS=5000
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
