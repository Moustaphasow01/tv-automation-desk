{
	admin 127.0.0.1:2019
	email {$DESK_TLS_EMAIL}
}

{$DESK_PUBLIC_HOST} {
	encode zstd gzip

	log {
		output file "{$DESK_LOG_ROOT}\caddy-access.json" {
			roll_size 50mb
			roll_keep 10
			roll_keep_for 336h
		}
		format filter {
			request>uri query {
				replace token REDACTED
				replace secret REDACTED
			}
			wrap json
		}
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://chatgpt.com"
	}

	@backend path /status /readyz /healthz /api/* /front-api/* /mcp /oauth/* /.well-known/* /sse /messages
	handle @backend {
		reverse_proxy 127.0.0.1:8787 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	handle {
		root * "{$DESK_FRONT_ROOT}"
		try_files {path} /index.html
		file_server
	}
}
