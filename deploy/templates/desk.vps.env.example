TRADINGVIEW_WEBHOOK_RATE_LIMIT_PER_MINUTE=300
TRADINGVIEW_WEBHOOK_MAX_AGE_SECONDS=
TRADINGVIEW_WEBHOOK_MAX_FUTURE_SKEW_SECONDS=300

DESK_OBJECT_ROOT=__DESK_DATA_ROOT__\objects
DESK_NINJA_STARTUP_CONTROL_ROOT=__DESK_DATA_ROOT__\ninjatrader-control
DESK_LOCAL_PACK_BUILDER_ENABLED=true
DESK_LIVE_EXECUTION_MODE=shadow
DESK_LIVE_PAPER_EXECUTION_ENABLED=true
DESK_LIVE_MONITOR_TRIGGER_MAX_AGE_MS=1200000
DESK_LIVE_SCHEDULER_POLL_MS=15000
DESK_MACRO_CALENDAR_ENABLED=true
DESK_MACRO_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
DESK_FOREX_FACTORY_ACTUAL_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.ics
