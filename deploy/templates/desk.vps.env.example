DESK_NEWS_MIN_REFRESH_MS=600000
DESK_NEWS_FAILURE_BACKOFF_MS=900000
DESK_NEWS_MAX_FAILURE_BACKOFF_MS=21600000

# Codex analytical workers are installed as Windows services in shadow mode first.
# The service templates own the unique worker IDs and lane scopes.
DESK_RUNTIME_PROFILE=standard
DESK_AI_WORKER_MODE=shadow
DESK_AI_WORKER_POLL_MS=15000
DESK_AI_REPLAY_SELECTOR_MODE=next_ready_config
