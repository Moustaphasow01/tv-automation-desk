# Rendered by Install-Desk.ps1. Never commit the generated production file.
NODE_ENV=production
DESK_ENVIRONMENT=preprod
DESK_PUBLIC_MODE=true
DESK_BIND_HOST=127.0.0.1
PORT=8787
DESK_SERVICE_ROLE=all

DESK_MCP_PUBLIC_BASE_URL=https://__DESK_DOMAIN__
DESK_REST_ALLOWED_ORIGINS=https://__DESK_DOMAIN__
DESK_TRUST_PROXY=true
DESK_MCP_TOOL_PROFILE=autopilot_v4
DESK_GPT_MCP_STORE=postgres
DATABASE_URL=postgresql://desk_runtime:__DESK_DB_RUNTIME_PASSWORD__@127.0.0.1:5432/desk
DESK_AI_CONTEXT_DATABASE_URL=postgresql://desk_ai_context:__DESK_DB_CONTEXT_PASSWORD__@127.0.0.1:5432/desk
DESK_DATABASE_POOL_SIZE=12
DESK_DATABASE_CONNECTION_TIMEOUT_MS=5000
DESK_DATABASE_IDLE_TIMEOUT_MS=30000
DESK_DATABASE_QUERY_TIMEOUT_MS=30000
DESK_DATABASE_STATEMENT_TIMEOUT_MS=30000
DESK_DATABASE_LOCK_TIMEOUT_MS=5000
DESK_DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
DESK_DATABASE_APPLICATION_NAME=desk-runtime
DESK_POSTGRES_SCHEMA_MODE=validate
# Prospective USDA calendar producer. Enable after migration 063 and source-access qualification.
DESK_GRAINS_CALENDAR_ENABLED=false
FRONT_OPERATIONS_LIST_CACHE_TTL_MS=15000
FRONT_OPERATIONS_SUMMARY_CACHE_TTL_MS=15000
DESK_PREWARM_OPERATIONS_SUMMARY=true
DESK_HTTP_REQUEST_TIMEOUT_MS=60000
DESK_HTTP_HEADERS_TIMEOUT_MS=15000
DESK_HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
DESK_SHUTDOWN_DEADLINE_MS=20000
DESK_MCP_SESSION_IDLE_MS=1800000
DESK_REPLAY_PREPARATION_POLL_MS=0
DESK_REPLAY_PREPARATION_WORKER_POLL_MS=2000
DESK_EXPECTED_SERVICE_IDS=live_runtime_scheduler,replay_preparation_worker,broker_management,telegram_alert_worker,agent_runtime_supervisor_live,codex_live_worker_01,codex_live_worker_02,codex_replay_worker_01
DESK_RETENTION_TRADINGVIEW_DAYS=30
DESK_RETENTION_ADDON_SNAPSHOTS_DAYS=14
DESK_RETENTION_ADDON_EVENTS_DAYS=90
DESK_RETENTION_PARITY_RUNS_DAYS=30
DESK_RETENTION_RECONCILIATION_RUNS_DAYS=90
DESK_RETENTION_TRANSIENT_DOCUMENT_DAYS=90

DESK_MCP_API_KEY=__DESK_MCP_API_KEY__
DESK_OAUTH_ADMIN_PIN=__DESK_OAUTH_ADMIN_PIN__
DESK_OAUTH_TOKEN_SECRET=__DESK_OAUTH_TOKEN_SECRET__
DESK_OPERATOR_ADMIN_PIN=__DESK_OPERATOR_ADMIN_PIN__
DESK_OPERATOR_SESSION_SECRET=__DESK_OPERATOR_SESSION_SECRET__
TRADINGVIEW_WEBHOOK_SECRET=__TRADINGVIEW_WEBHOOK_SECRET__
