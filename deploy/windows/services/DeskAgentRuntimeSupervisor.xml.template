<service>
  <id>DeskFuturesAgentRuntimeSupervisor</id>
  <name>Desk Futures Agent Runtime Supervisor</name>
  <description>Generic event-driven supervisor for durable agent runtime tasks.</description>
  <executable>__NODE_EXE__</executable>
  <arguments>--env-file="__ENV_FILE__" "__INSTALL_ROOT__\current\app\mcp_gpt_desk\scripts\run_agent_runtime_supervisor.mjs"</arguments>
  <workingdirectory>__INSTALL_ROOT__\current\app\mcp_gpt_desk</workingdirectory>
  <env name="DESK_AGENT_SUPERVISOR_SERVICE_ID" value="agent_runtime_supervisor_live"/>
  <env name="DESK_AGENT_SUPERVISOR_HOST_PLATFORM" value="windows-service"/>
  <env name="DESK_AGENT_SUPERVISOR_ID" value="agent-runtime-live-01"/>
  <env name="DESK_AGENT_WORKER_POOL" value="live"/>
  <env name="DESK_AGENT_POOL_POLICY_JSON" value=""/>
  <env name="DESK_AGENT_SUPERVISOR_LANE" value="live"/>
  <env name="DESK_AGENT_SUPERVISOR_MODE" value="__AGENT_SUPERVISOR_MODE__"/>
  <env name="DESK_AGENT_SUPERVISOR_POLL_MS" value="15000"/>
  <env name="DESK_AGENT_SUPERVISOR_LEASE_SECONDS" value="900"/>
  <env name="DESK_AGENT_CONVERSATION_PROVIDER" value="codex"/>
  <env name="DESK_AGENT_CONVERSATION_MAX_TURNS" value="12"/>
  <env name="DESK_AGENT_MODEL" value="codex"/>
  <env name="DESK_AGENT_REASONING_EFFORT" value="xhigh"/>
  <env name="DESK_AGENT_TIMEOUT_MS" value="780000"/>
  <env name="DESK_AGENT_TOKEN_BUDGET" value="0"/>
  <env name="DESK_AGENT_MAX_OUTPUT_TOKENS" value="0"/>
  <env name="DESK_AGENT_RETRY_BASE_DELAY_SECONDS" value="60"/>
  <env name="DESK_AGENT_RETRY_MAX_DELAY_SECONDS" value="900"/>
  <env name="DESK_AGENT_RETRY_MULTIPLIER" value="2"/>
  <env name="DESK_AGENT_RETRY_JITTER_SECONDS" value="0"/>
  <env name="DESK_AGENT_SCHEDULER_MODE" value="disabled"/>
  <env name="DESK_AGENT_SUPERVISOR_PROJECT_ROOT" value="__INSTALL_ROOT__\current\app\mcp_gpt_desk"/>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <depend>__POSTGRES_SERVICE__</depend>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>__LOG_ROOT__\agent-runtime-supervisor</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
