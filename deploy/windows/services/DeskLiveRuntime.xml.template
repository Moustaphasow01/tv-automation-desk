<service>
  <id>DeskFuturesLiveRuntime</id>
  <name>Desk Futures LIVE Runtime</name>
  <description>GPT M5 pack scheduler and deterministic M1 setup/position engine.</description>
  <executable>__NODE_EXE__</executable>
  <arguments>--env-file="__ENV_FILE__" "__INSTALL_ROOT__\current\app\mcp_gpt_desk\scripts\run_live_runtime_scheduler.mjs"</arguments>
  <workingdirectory>__INSTALL_ROOT__\current\app\mcp_gpt_desk</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <depend>__POSTGRES_SERVICE__</depend>
  <depend>DeskFuturesApi</depend>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>__LOG_ROOT__\live-runtime</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10485760</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
