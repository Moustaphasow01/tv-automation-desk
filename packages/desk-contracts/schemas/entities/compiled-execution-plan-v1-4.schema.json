        },
        "best_short": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "blocking_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {}
        },
        "wait_to_go_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {}
        },
        "revalidation_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {}
