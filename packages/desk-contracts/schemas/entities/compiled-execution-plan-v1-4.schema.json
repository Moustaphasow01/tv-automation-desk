    },
    "diagnostics": {
      "type": "object",
      "required": [
        "errors",
        "warnings",
        "normalizations"
      ],
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnosticEntry"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnosticEntry"
          }
        },
        "normalizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnosticEntry"
          }
        }
