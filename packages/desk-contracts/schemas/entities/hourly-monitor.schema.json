{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tv-automation.local/contracts/hourly-monitor.schema.json",
  "title": "DeskHourlyThesisMonitorContract",
  "version": "1.0.0",
  "type": "object",
  "properties": {
    "monitor_id": {
      "type": "string",
      "minLength": 3
