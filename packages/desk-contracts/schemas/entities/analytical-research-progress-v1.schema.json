{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tv-automation.local/contracts/analytical-research-progress-v1.schema.json",
  "title": "DeskAnalyticalResearchProgressContract",
  "version": "1.0.0",
  "description": "Backend-derived progress projection for the ordered analytical protocol shared by LIVE and REPLAY. Normative companion definitions cover evidence receipts, claim scope, parity, anti-lookahead and read-only context tools.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "desk_analytical_research_progress_v1"
    },
    "status": {
      "$ref": "#/$defs/phase_status"
    },
    "current_phase": {
      "oneOf": [
        {
          "$ref": "#/$defs/phase_name"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at_utc": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "phases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/phase_progress"
            },
            {
              "properties": {
                "phase": {
                  "const": "CONTINUITY"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/phase_progress"
            },
            {
              "properties": {
                "phase": {
                  "const": "CORE_MARKET"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/phase_progress"
            },
            {
              "properties": {
                "phase": {
                  "const": "INDEX_CONFIRMATION"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/phase_progress"
            },
            {
              "properties": {
                "phase": {
                  "const": "CROSS_ASSET"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/phase_progress"
            },
            {
              "properties": {
                "phase": {
                  "const": "MEGACAPS"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/phase_progress"
            },
            {
              "properties": {
                "phase": {
                  "const": "MACRO"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/phase_progress"
            },
            {
              "properties": {
                "phase": {
                  "const": "NEWS"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/phase_progress"
            },
            {
              "properties": {
                "phase": {
                  "const": "THESIS_EVOLUTION"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/phase_progress"
            },
            {
              "properties": {
                "phase": {
                  "const": "OPPORTUNITY"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/phase_progress"
            },
            {
              "properties": {
                "phase": {
                  "const": "CONCLUSION"
                }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "tool_calls_count": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_receipts_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "status",
    "current_phase",
    "started_at_utc",
    "updated_at_utc",
    "phases",
    "coverage",
    "tool_calls_count",
    "evidence_receipts_count"
  ],
  "additionalProperties": false,
  "$defs": {
    "phase_name": {
      "type": "string",
      "enum": [
        "CONTINUITY",
        "CORE_MARKET",
        "INDEX_CONFIRMATION",
        "CROSS_ASSET",
        "MEGACAPS",
        "MACRO",
        "NEWS",
        "THESIS_EVOLUTION",
        "OPPORTUNITY",
        "CONCLUSION"
      ]
    },
    "phase_status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "COMPLETE",
        "DEGRADED",
        "UNAVAILABLE",
        "BLOCKED"
      ]
    },
    "terminal_phase_status": {
      "type": "string",
      "enum": [
        "COMPLETE",
        "DEGRADED",
        "UNAVAILABLE",
        "BLOCKED"
      ]
    },
    "symbolic_code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,79}$"
    },
    "nullable_timestamp": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "phase_progress": {
      "type": "object",
      "properties": {
        "phase": {
          "$ref": "#/$defs/phase_name"
        },
        "status": {
          "$ref": "#/$defs/phase_status"
        },
        "required": {
          "const": true
        },
        "evidence_count": {
          "type": "integer",
          "minimum": 0
        },
        "tool_call_count": {
          "type": "integer",
          "minimum": 0
        },
        "started_at_utc": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "completed_at_utc": {
          "$ref": "#/$defs/nullable_timestamp"
        },
        "degraded_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbolic_code"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "phase",
        "status",
        "required",
        "evidence_count",
        "tool_call_count",
        "started_at_utc",
        "completed_at_utc",
        "degraded_reasons"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_STARTED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "started_at_utc": {
                "type": "null"
              },
              "completed_at_utc": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "IN_PROGRESS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "started_at_utc": {
                "type": "string",
                "format": "date-time"
              },
              "completed_at_utc": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "$ref": "#/$defs/terminal_phase_status"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "started_at_utc": {
                "type": "string",
                "format": "date-time"
              },
              "completed_at_utc": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "properties": {
        "required": {
          "const": 10
        },
        "total": {
          "const": 10
        },
        "complete": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "required",
        "total",
        "complete",
        "percent"
      ],
      "additionalProperties": false
    },
    "evidence_source": {
      "type": "object",
      "properties": {
        "source_type": {
          "$ref": "#/$defs/symbolic_code"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_type",
        "source_id",
        "source_version",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "evidence_receipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "desk_analytical_evidence_receipt_v1"
        },
        "issuer": {
          "const": "DESK_BACKEND"
        },
        "journey_id": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "$ref": "#/$defs/phase_name"
        },
        "phase_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "evidence_kind": {
          "$ref": "#/$defs/symbolic_code"
        },
        "source": {
          "$ref": "#/$defs/evidence_source"
        },
        "availability": {
          "type": "string",
          "enum": [
            "AVAILABLE",
            "DEGRADED",
            "UNAVAILABLE",
            "BLOCKED"
          ]
        },
        "effective_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "cutoff_utc": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_hash_origin": {
          "type": "string",
          "enum": [
            "BACKEND_HASHED_PAYLOAD",
            "IMMUTABLE_SOURCE_HASH",
            "BACKEND_ABSENCE_ASSERTION"
          ]
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbolic_code"
          },
          "uniqueItems": true
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/symbolic_code"
          },
          "uniqueItems": true
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "issued_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^analytical_evidence_[a-f0-9]{32}$"
        },
        "receipt_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "issuer",
        "journey_id",
        "phase",
        "phase_ordinal",
        "evidence_kind",
        "source",
        "availability",
        "effective_at_utc",
        "cutoff_utc",
        "content_hash",
        "content_hash_origin",
        "quality_flags",
        "reason_codes",
        "metadata",
        "issued_at_utc",
        "receipt_id",
        "receipt_hash"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "enum": [
                  "DEGRADED",
                  "UNAVAILABLE",
                  "BLOCKED"
                ]
              }
            },
            "required": [
              "availability"
            ]
          },
          "then": {
            "properties": {
              "reason_codes": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "CONTINUITY"
              }
            }
          },
          "then": {
            "properties": {
              "phase_ordinal": {
                "const": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "CORE_MARKET"
              }
            }
          },
          "then": {
            "properties": {
              "phase_ordinal": {
                "const": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "INDEX_CONFIRMATION"
              }
            }
          },
          "then": {
            "properties": {
              "phase_ordinal": {
                "const": 3
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "CROSS_ASSET"
              }
            }
          },
          "then": {
            "properties": {
              "phase_ordinal": {
                "const": 4
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "MEGACAPS"
              }
            }
          },
          "then": {
            "properties": {
              "phase_ordinal": {
                "const": 5
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "MACRO"
              }
            }
          },
          "then": {
            "properties": {
              "phase_ordinal": {
                "const": 6
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "NEWS"
              }
            }
          },
          "then": {
            "properties": {
              "phase_ordinal": {
                "const": 7
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "THESIS_EVOLUTION"
              }
            }
          },
          "then": {
            "properties": {
              "phase_ordinal": {
                "const": 8
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "OPPORTUNITY"
              }
            }
          },
          "then": {
            "properties": {
              "phase_ordinal": {
                "const": 9
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "CONCLUSION"
              }
            }
          },
          "then": {
            "properties": {
              "phase_ordinal": {
                "const": 10
              }
            }
          }
        }
      ]
    },
    "claim_scope": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "live",
            "replay"
          ]
        },
        "workflow": {
          "type": "string",
          "enum": [
            "LIVE_MASTER",
            "LIVE_M15_MONITOR",
            "LIVE_M5_MONITOR",
            "REPLAY_MASTER",
            "REPLAY_MONITOR"
          ]
        },
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "lease_bound": {
          "const": true
        },
        "cursor_id": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint": {
          "type": "string",
          "format": "date-time"
        },
        "work_item_id": {
          "type": "string",
          "minLength": 1
        },
        "backtest_id": {
          "type": "string",
          "minLength": 1
        },
        "replay_run_id": {
          "type": "string",
          "minLength": 1
        },
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "trading_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "cutoff_utc": {
          "type": "string",
          "format": "date-time"
        },
        "pack_id": {
          "type": "string",
          "minLength": 1
        },
        "pack_build_id": {
          "type": "string",
          "minLength": 1
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mode",
        "workflow",
        "worker_id",
        "lease_bound",
        "trading_date",
        "session",
        "cutoff_utc",
        "pack_id",
        "pack_build_id",
        "bundle_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "live"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "cursor_id",
              "checkpoint",
              "run_id"
            ],
            "properties": {
              "workflow": {
                "enum": [
                  "LIVE_MASTER",
                  "LIVE_M15_MONITOR",
                  "LIVE_M5_MONITOR"
                ]
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "work_item_id"
                  ]
                },
                {
                  "required": [
                    "backtest_id"
                  ]
                },
                {
                  "required": [
                    "replay_run_id"
                  ]
                },
                {
                  "required": [
                    "step_id"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "work_item_id",
              "backtest_id",
              "replay_run_id",
              "step_id"
            ],
            "properties": {
              "workflow": {
                "enum": [
                  "REPLAY_MASTER",
                  "REPLAY_MONITOR"
                ]
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "cursor_id"
                  ]
                },
                {
                  "required": [
                    "checkpoint"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "read_only_tool_policy": {
      "type": "object",
      "properties": {
        "access_mode": {
          "const": "READ_ONLY"
        },
        "claim_scoped": {
          "const": true
        },
        "write_tools_allowed": {
          "const": false
        },
        "allowed_tools": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "get_context_catalog"
            },
            {
              "const": "get_continuity_context"
            },
            {
              "const": "get_market_context"
            },
            {
              "const": "get_macro_context"
            },
            {
              "const": "get_news_context"
            },
            {
              "const": "get_thesis_evolution_context"
            },
            {
              "const": "get_replay_section_page"
            },
            {
              "const": "get_market_dataset"
            }
          ],
          "items": false
        }
      },
      "required": [
        "access_mode",
        "claim_scoped",
        "write_tools_allowed",
        "allowed_tools"
      ],
      "additionalProperties": false
    },
    "anti_lookahead_envelope": {
      "type": "object",
      "properties": {
        "cutoff_utc": {
          "type": "string",
          "format": "date-time"
        },
        "available_data_until_utc": {
          "type": "string",
          "format": "date-time"
        },
        "future_data_used": {
          "const": false
        },
        "source_pack_id": {
          "type": "string",
          "minLength": 1
        },
        "pack_build_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_scope_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "cutoff_utc",
        "available_data_until_utc",
        "future_data_used",
        "source_pack_id",
        "pack_build_id",
        "claim_scope_hash"
      ],
      "additionalProperties": false
    },
    "live_replay_parity": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "live",
            "replay"
          ]
        },
        "protocol_version": {
          "const": "desk_analytical_research_progress_v1"
        },
        "same_phase_order": {
          "const": true
        },
        "same_evidence_rules": {
          "const": true
        },
        "same_completion_rules": {
          "const": true
        },
        "data_origin": {
          "type": "string",
          "enum": [
            "LIVE_SETTLED_ROLLING_CUTOFF",
            "REPLAY_IMMUTABLE_CUTOFF"
          ]
        }
      },
      "required": [
        "scope",
        "protocol_version",
        "same_phase_order",
        "same_evidence_rules",
        "same_completion_rules",
        "data_origin"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "live"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "data_origin": {
                "const": "LIVE_SETTLED_ROLLING_CUTOFF"
              }
            }
          },
          "else": {
            "properties": {
              "data_origin": {
                "const": "REPLAY_IMMUTABLE_CUTOFF"
              }
            }
          }
        }
      ]
    }
  }
}
