{
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "session": {
      "type": "string",
      "enum": [
        "asia_open",
        "london_session",
        "ny_open",
        "work_forward"
      ],
      "default": "asia_open"
    },
    "thesis_id": {
      "type": "string",
      "minLength": 3
    },
    "timestamp_paris": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "const": "Europe/Paris",
      "default": "Europe/Paris"
    }
  },
  "required": [],
  "additionalProperties": false
}
