{
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "session": {
      "type": "string",
      "enum": [
        "asia_open",
        "london_session",
        "ny_open",
        "work_forward"
      ],
      "default": "asia_open"
    },
    "timezone": {
      "type": "string",
      "const": "Europe/Paris",
      "default": "Europe/Paris"
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "paper",
        "replay"
      ],
      "default": "live"
    }
  },
  "required": [],
  "additionalProperties": false
}
