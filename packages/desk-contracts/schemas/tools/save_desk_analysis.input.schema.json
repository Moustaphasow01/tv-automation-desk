        "management_rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "time_rules": {
          "type": "object",
          "properties": {
            "earliest_entry_time": {
              "type": "string"
            },
            "latest_entry_time": {
              "type": "string"
            },
            "reduce_before": {
              "type": "string"
            },
            "flatten_before": {
              "type": "string"
            }
          },
          "required": [],
