        "timezone": {
          "type": "string",
          "const": "Europe/Paris",
          "default": "Europe/Paris"
        },
        "instrument": {
          "type": "string",
          "enum": [
            "MNQ",
            "NQ",
            "MES",
            "ES",
            "WAIT"
          ]
        },
        "asset_class": {
          "type": "string",
          "const": "futures",
          "default": "futures"
        },
        "decision": {
          "type": "string",
          "enum": [
            "prendre",
            "ne_pas_prendre",
            "wait",
            "gestion_seule"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "long",
