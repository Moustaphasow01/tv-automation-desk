//@version=6
indicator("TVAutomation Market Feed Batch H4", overlay=false, precision=6)

// Exporteur statique conservé pour les alertes TradingView multi-symboles.
// Add this indicator to a chart on the matching timeframe and create
// one TradingView alert with "Any alert() function call".

TF = "240"
CANONICAL_TF = "4H"
BATCH_NAME = "TVA_BATCH_H4"
RSI_LEN = 14
ATR_LEN = 14

f_num(x) =>
    na(x) ? "null" : str.tostring(x)

f_time(x) =>
    str.format_time(x, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")

f_candle(string asset, string symbol, string ticker, t, o, h, l, c, v, r, a) =>
    string item = "{"
    item := item + '"source":"tradingview_webhook",'
    item := item + '"type":"market_feed_batch_item",'
    item := item + '"alert_id":"' + symbol + "_" + CANONICAL_TF + "_" + str.tostring(t) + '",'
    item := item + '"asset":"' + asset + '",'
    item := item + '"symbol":"' + symbol + '",'
    item := item + '"ticker":"' + ticker + '",'
    item := item + '"timeframe":"' + CANONICAL_TF + '",'
    item := item + '"timestamp_utc":"' + f_time(t) + '",'
    item := item + '"bar_status":"closed",'
    item := item + '"confirmed":true,'
    item := item + '"time":' + str.tostring(t) + ','
    item := item + '"open":' + f_num(o) + ','
    item := item + '"high":' + f_num(h) + ','
    item := item + '"low":' + f_num(l) + ','
    item := item + '"close":' + f_num(c) + ','
    item := item + '"volume":' + f_num(v) + ','
    item := item + '"price":{'
    item := item + '"open":' + f_num(o) + ','
    item := item + '"high":' + f_num(h) + ','
    item := item + '"low":' + f_num(l) + ','
    item := item + '"close":' + f_num(c) + ','
    item := item + '"volume":' + f_num(v)
    item := item + '},'
    item := item + '"studies":{'
    item := item + '"rsi_14":' + f_num(r) + ','
    item := item + '"atr_10":' + f_num(a) + ','
    item := item + '"atr_14":' + f_num(a)
    item := item + '}'
    item := item + "}"
    item

[s1t, s1o, s1h, s1l, s1c, s1v, s1r, s1a] = request.security("CME_MINI:MNQ1!", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c1 = f_candle("MNQ", "MNQ1!", "CME_MINI:MNQ1!", s1t, s1o, s1h, s1l, s1c, s1v, s1r, s1a)

[s2t, s2o, s2h, s2l, s2c, s2v, s2r, s2a] = request.security("CME_MINI:MES1!", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c2 = f_candle("MES", "MES1!", "CME_MINI:MES1!", s2t, s2o, s2h, s2l, s2c, s2v, s2r, s2a)

[s3t, s3o, s3h, s3l, s3c, s3v, s3r, s3a] = request.security("CME_MINI:NQ1!", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c3 = f_candle("NQ", "NQ1!", "CME_MINI:NQ1!", s3t, s3o, s3h, s3l, s3c, s3v, s3r, s3a)

[s4t, s4o, s4h, s4l, s4c, s4v, s4r, s4a] = request.security("CME_MINI:ES1!", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c4 = f_candle("ES", "ES1!", "CME_MINI:ES1!", s4t, s4o, s4h, s4l, s4c, s4v, s4r, s4a)

[s5t, s5o, s5h, s5l, s5c, s5v, s5r, s5a] = request.security("TVC:US10Y", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c5 = f_candle("US10Y", "US10Y", "TVC:US10Y", s5t, s5o, s5h, s5l, s5c, s5v, s5r, s5a)

[s6t, s6o, s6h, s6l, s6c, s6v, s6r, s6a] = request.security("TVC:US02Y", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c6 = f_candle("US02Y", "US02Y", "TVC:US02Y", s6t, s6o, s6h, s6l, s6c, s6v, s6r, s6a)

[s7t, s7o, s7h, s7l, s7c, s7v, s7r, s7a] = request.security("TVC:DXY", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c7 = f_candle("DXY", "DXY", "TVC:DXY", s7t, s7o, s7h, s7l, s7c, s7v, s7r, s7a)

[s8t, s8o, s8h, s8l, s8c, s8v, s8r, s8a] = request.security("NYMEX:CL1!", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c8 = f_candle("CL", "CL1!", "NYMEX:CL1!", s8t, s8o, s8h, s8l, s8c, s8v, s8r, s8a)

[s9t, s9o, s9h, s9l, s9c, s9v, s9r, s9a] = request.security("COMEX:GC1!", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c9 = f_candle("GC", "GC1!", "COMEX:GC1!", s9t, s9o, s9h, s9l, s9c, s9v, s9r, s9a)

[s10t, s10o, s10h, s10l, s10c, s10v, s10r, s10a] = request.security("CBOE:VIX", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
