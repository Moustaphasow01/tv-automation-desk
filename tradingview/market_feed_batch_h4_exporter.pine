//@version=6
indicator("TVAutomation Market Feed Batch H4", overlay=false, precision=6)

// Exporteur statique conservé pour les alertes TradingView multi-symboles.
// Add this indicator to a chart on the matching timeframe and create
// one TradingView alert with "Any alert() function call".

TF = "240"
CANONICAL_TF = "4H"
BATCH_NAME = "TVA_BATCH_H4"
RSI_LEN = 14
ATR_10_LEN = 10
ATR_14_LEN = 14

type FeedPoint
    int t
    float o
    float h
    float l
    float c
    float v
    float r
    float a10
    float a14

f_feed_point() =>
    FeedPoint.new(time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_10_LEN), ta.atr(ATR_14_LEN))

f_num(x) =>
    na(x) ? "null" : str.tostring(x)

f_time(x) =>
    str.format_time(x, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")

f_candle(string asset, string symbol, string ticker, FeedPoint point) =>
    t = point.t
    o = point.o
    h = point.h
    l = point.l
    c = point.c
    v = point.v
    r = point.r
    a10 = point.a10
    a14 = point.a14
    string item = "{"
    item := item + '"source":"tradingview_webhook",'
    item := item + '"type":"market_feed_batch_item",'
    item := item + '"alert_id":"' + symbol + "_" + CANONICAL_TF + "_" + str.tostring(t) + '",'
    item := item + '"asset":"' + asset + '",'
    item := item + '"symbol":"' + symbol + '",'
    item := item + '"ticker":"' + ticker + '",'
    item := item + '"timeframe":"' + CANONICAL_TF + '",'
    item := item + '"timestamp_utc":"' + f_time(t) + '",'
    item := item + '"bar_status":"closed",'
    item := item + '"confirmed":true,'
    item := item + '"time":' + str.tostring(t) + ','
    item := item + '"open":' + f_num(o) + ','
    item := item + '"high":' + f_num(h) + ','
    item := item + '"low":' + f_num(l) + ','
    item := item + '"close":' + f_num(c) + ','
    item := item + '"volume":' + f_num(v) + ','
    item := item + '"price":{'
    item := item + '"open":' + f_num(o) + ','
    item := item + '"high":' + f_num(h) + ','
    item := item + '"low":' + f_num(l) + ','
    item := item + '"close":' + f_num(c) + ','
    item := item + '"volume":' + f_num(v)
    item := item + '},'
    item := item + '"studies":{'
    item := item + '"rsi_14":' + f_num(r) + ','
    item := item + '"atr_10":' + f_num(a10) + ','
    item := item + '"atr_14":' + f_num(a14)
    item := item + '}'
    item := item + "}"
    item

s1 = request.security("CME_MINI:MNQ1!", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c1 = f_candle("MNQ", "MNQ1!", "CME_MINI:MNQ1!", s1)

s2 = request.security("CME_MINI:MES1!", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c2 = f_candle("MES", "MES1!", "CME_MINI:MES1!", s2)

s3 = request.security("CME_MINI:NQ1!", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c3 = f_candle("NQ", "NQ1!", "CME_MINI:NQ1!", s3)

s4 = request.security("CME_MINI:ES1!", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c4 = f_candle("ES", "ES1!", "CME_MINI:ES1!", s4)

s5 = request.security("TVC:US10Y", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c5 = f_candle("US10Y", "US10Y", "TVC:US10Y", s5)

s6 = request.security("TVC:US02Y", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c6 = f_candle("US02Y", "US02Y", "TVC:US02Y", s6)

s7 = request.security("TVC:DXY", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c7 = f_candle("DXY", "DXY", "TVC:DXY", s7)

s8 = request.security("NYMEX:CL1!", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c8 = f_candle("CL", "CL1!", "NYMEX:CL1!", s8)

s9 = request.security("COMEX:GC1!", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c9 = f_candle("GC", "GC1!", "COMEX:GC1!", s9)

s10 = request.security("CBOE:VIX", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c10 = f_candle("VIX", "VIX", "CBOE:VIX", s10)

s11 = request.security("TVC:NI225", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c11 = f_candle("NIKKEI", "NI225", "TVC:NI225", s11)

s12 = request.security("TVC:HSI", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c12 = f_candle("HANG_SENG", "HSI", "TVC:HSI", s12)

s13 = request.security("XETR:DAX", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c13 = f_candle("DAX", "DAX", "XETR:DAX", s13)

s14 = request.security("TVC:SX5E", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c14 = f_candle("EURO_STOXX", "SX5E", "TVC:SX5E", s14)

s15 = request.security("NASDAQ:NVDA", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c15 = f_candle("NVDA", "NVDA", "NASDAQ:NVDA", s15)

s16 = request.security("NASDAQ:AAPL", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c16 = f_candle("AAPL", "AAPL", "NASDAQ:AAPL", s16)

s17 = request.security("NASDAQ:MSFT", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c17 = f_candle("MSFT", "MSFT", "NASDAQ:MSFT", s17)

s18 = request.security("NASDAQ:AMZN", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c18 = f_candle("AMZN", "AMZN", "NASDAQ:AMZN", s18)

s19 = request.security("NASDAQ:META", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c19 = f_candle("META", "META", "NASDAQ:META", s19)

s20 = request.security("NASDAQ:GOOGL", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c20 = f_candle("GOOGL", "GOOGL", "NASDAQ:GOOGL", s20)

s21 = request.security("NASDAQ:AVGO", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c21 = f_candle("AVGO", "AVGO", "NASDAQ:AVGO", s21)

s22 = request.security("NASDAQ:TSLA", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c22 = f_candle("TSLA", "TSLA", "NASDAQ:TSLA", s22)

s23 = request.security("NASDAQ:SMH", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c23 = f_candle("SMH", "SMH", "NASDAQ:SMH", s23)

s24 = request.security("NASDAQ:SOXX", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c24 = f_candle("SOXX", "SOXX", "NASDAQ:SOXX", s24)

s25 = request.security("CBOT:ZC1!", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c25 = f_candle("ZC", "ZC1!", "CBOT:ZC1!", s25)

s26 = request.security("CBOT:ZW1!", TF, f_feed_point(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c26 = f_candle("ZW", "ZW1!", "CBOT:ZW1!", s26)

payload = "{"
payload := payload + '"source":"tradingview_webhook",'
payload := payload + '"type":"market_feed_batch",'
payload := payload + '"batch_id":"' + BATCH_NAME + "_" + str.tostring(time) + '",'
payload := payload + '"timeframe":"' + CANONICAL_TF + '",'
payload := payload + '"bar_status":"closed",'
payload := payload + '"candles":['
payload := payload + "" + c1
payload := payload + "," + c2
payload := payload + "," + c3
payload := payload + "," + c4
payload := payload + "," + c5
payload := payload + "," + c6
payload := payload + "," + c7
payload := payload + "," + c8
payload := payload + "," + c9
payload := payload + "," + c10
payload := payload + "," + c11
payload := payload + "," + c12
payload := payload + "," + c13
payload := payload + "," + c14
payload := payload + "," + c15
payload := payload + "," + c16
payload := payload + "," + c17
payload := payload + "," + c18
payload := payload + "," + c19
payload := payload + "," + c20
payload := payload + "," + c21
payload := payload + "," + c22
payload := payload + "," + c23
payload := payload + "," + c24
payload := payload + "," + c25
payload := payload + "," + c26
payload := payload + ']'
payload := payload + "}"

plot(str.length(payload), title="payload_length", display=display.none)

if barstate.isconfirmed
    alert(payload, alert.freq_once_per_bar_close)
