[s11t, s11o, s11h, s11l, s11c, s11v, s11r, s11a] = request.security("TVC:NI225", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c11 = f_candle("NIKKEI", "NI225", "TVC:NI225", s11t, s11o, s11h, s11l, s11c, s11v, s11r, s11a)

[s12t, s12o, s12h, s12l, s12c, s12v, s12r, s12a] = request.security("TVC:HSI", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c12 = f_candle("HANG_SENG", "HSI", "TVC:HSI", s12t, s12o, s12h, s12l, s12c, s12v, s12r, s12a)

[s13t, s13o, s13h, s13l, s13c, s13v, s13r, s13a] = request.security("XETR:DAX", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c13 = f_candle("DAX", "DAX", "XETR:DAX", s13t, s13o, s13h, s13l, s13c, s13v, s13r, s13a)

[s14t, s14o, s14h, s14l, s14c, s14v, s14r, s14a] = request.security("TVC:SX5E", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c14 = f_candle("EURO_STOXX", "SX5E", "TVC:SX5E", s14t, s14o, s14h, s14l, s14c, s14v, s14r, s14a)

[s15t, s15o, s15h, s15l, s15c, s15v, s15r, s15a] = request.security("NASDAQ:NVDA", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c15 = f_candle("NVDA", "NVDA", "NASDAQ:NVDA", s15t, s15o, s15h, s15l, s15c, s15v, s15r, s15a)

[s16t, s16o, s16h, s16l, s16c, s16v, s16r, s16a] = request.security("NASDAQ:AAPL", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c16 = f_candle("AAPL", "AAPL", "NASDAQ:AAPL", s16t, s16o, s16h, s16l, s16c, s16v, s16r, s16a)

[s17t, s17o, s17h, s17l, s17c, s17v, s17r, s17a] = request.security("NASDAQ:MSFT", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c17 = f_candle("MSFT", "MSFT", "NASDAQ:MSFT", s17t, s17o, s17h, s17l, s17c, s17v, s17r, s17a)

[s18t, s18o, s18h, s18l, s18c, s18v, s18r, s18a] = request.security("NASDAQ:TSLA", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c18 = f_candle("TSLA", "TSLA", "NASDAQ:TSLA", s18t, s18o, s18h, s18l, s18c, s18v, s18r, s18a)

[s19t, s19o, s19h, s19l, s19c, s19v, s19r, s19a] = request.security("NASDAQ:SMH", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c19 = f_candle("SMH", "SMH", "NASDAQ:SMH", s19t, s19o, s19h, s19l, s19c, s19v, s19r, s19a)

[s20t, s20o, s20h, s20l, s20c, s20v, s20r, s20a] = request.security("NASDAQ:SOXX", TF, [time, open, high, low, close, nz(volume), ta.rsi(close, RSI_LEN), ta.atr(ATR_LEN)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
c20 = f_candle("SOXX", "SOXX", "NASDAQ:SOXX", s20t, s20o, s20h, s20l, s20c, s20v, s20r, s20a)

payload = "{"
payload := payload + '"source":"tradingview_webhook",'
payload := payload + '"type":"market_feed_batch",'
payload := payload + '"batch_id":"' + BATCH_NAME + "_" + str.tostring(time) + '",'
payload := payload + '"timeframe":"' + CANONICAL_TF + '",'
payload := payload + '"bar_status":"closed",'
payload := payload + '"candles":['
payload := payload + "" + c1
payload := payload + "," + c2
payload := payload + "," + c3
payload := payload + "," + c4
payload := payload + "," + c5
payload := payload + "," + c6
payload := payload + "," + c7
payload := payload + "," + c8
payload := payload + "," + c9
payload := payload + "," + c10
payload := payload + "," + c11
payload := payload + "," + c12
payload := payload + "," + c13
payload := payload + "," + c14
payload := payload + "," + c15
payload := payload + "," + c16
payload := payload + "," + c17
payload := payload + "," + c18
payload := payload + "," + c19
payload := payload + "," + c20
payload := payload + ']'
payload := payload + "}"

plot(str.length(payload), title="payload_length", display=display.none)

if barstate.isconfirmed
    alert(payload, alert.freq_once_per_bar_close)
