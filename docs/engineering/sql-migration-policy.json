        "^tradingview_",
        "^desk_import_",
        "^desk_document_quarantine$",
        "^news_",
        "^data_sources$",
        "^ingestion_batches$",
        "^datasets$",
        "^dataset_"
      ]
    },
    {
      "owner": "execution",
      "patterns": [
        "^broker_",
        "^human_execution_",
        "^trade_",
        "^trades$"
      ]
    },
    {
      "owner": "strategy",
      "patterns": [
