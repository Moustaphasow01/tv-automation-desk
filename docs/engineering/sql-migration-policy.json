      "patterns": [
        "^simulation_"
      ]
    },
    {
      "owner": "research",
      "patterns": [
        "^research_"
      ]
    },
    {
      "owner": "portfolio-risk",
      "patterns": [
        "^portfolio_"
      ]
    },
    {
      "owner": "operations",
