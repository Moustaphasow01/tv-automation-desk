  "allowed_destructive_statements": [
    {
      "file": "007_remove_legacy_v4.sql",
      "starts_with": "DELETE FROM desk_documents",
      "reason": "Legacy V4 desk_cross_asset_deltas data cleanup approved before immutable pack cutover."
    }
  ],
  "destructive_operations": [
    "DROP TABLE",
    "DROP COLUMN",
    "TRUNCATE",
    "DELETE FROM"
  ]
}
